server:
  port: 8099

# 线程池配置
thread:
  pool:
    executor:
      config:
        core-pool-size: 20
        max-pool-size: 50
        keep-alive-time: 5000
        block-queue-size: 5000
        policy: CallerRunsPolicy

# 数据库配置；启动时配置数据库资源信息
spring:
  datasource:
    mysql:
      username: root
      password: your_password_here
      url: jdbc:mysql://127.0.0.1:13306/ai-agent-station-study?useUnicode=true&characterEncoding=utf8&autoReconnect=true&zeroDateTimeBehavior=convertToNull&serverTimezone=Asia/Shanghai&useSSL=true
      driver-class-name: com.mysql.cj.jdbc.Driver
      type: com.zaxxer.hikari.HikariDataSource
      hikari:
        pool-name: Retail_HikariCP
        minimum-idle: 15 #最小空闲连接数量
        idle-timeout: 180000 #空闲连接存活最大时间，默认600000（10分钟）
        maximum-pool-size: 25 #连接池最大连接数，默认是10
        auto-commit: true  #此属性控制从池返回的连接的默认自动提交行为,默认值：true
        max-lifetime: 1800000 #此属性控制池中连接的最长生命周期，值0表示无限生命周期，默认1800000即30分钟
        connection-timeout: 30000 #数据库连接超时时间,默认30秒，即30000
        connection-test-query: SELECT 1
    pgvector:
      driver-class-name: org.postgresql.Driver
      username: postgres
      password: postgres
      url: jdbc:postgresql://127.0.0.1:15432/ai-rag-knowledge
      type: com.zaxxer.hikari.HikariDataSource
      hikari:
        maximum-pool-size: 5
        minimum-idle: 2
        idle-timeout: 30000
        connection-timeout: 30000
  ai:
    # SSE 连接超时（毫秒）。需大于下面的 total-budget-ms，否则链路还没走完总结就被 emitter 掐断
    sse-timeout-millis: 600000
    openai:
      base-url: https://token-plan-cn.xiaomimimo.com
      api-key: your_api_key_here
    agent:
      auto-config:
        enabled: true
    # 多节点链路的节点治理：超时 / 重试 / 降级 / 全局预算
    node-guard:
      enabled: true
      # 全局 deadline：整条链路的总预算，每个节点的硬超时都会被它二次裁剪
      total-budget-ms: 240000
      # 未单独配置的节点取这个值
      default-node-timeout-ms: 30000
      # 逐节点硬超时：需要按 workload 区分（纯生成 < 带工具调用 < 长文本规划）
      node-timeout-ms:
        flow.step1.tool-analysis: 45000
        flow.step2.planning: 60000
        flow.step3.parse-steps: 5000
        flow.step4.execute-steps: 90000
        auto.step1.analyzer: 30000
        auto.step2.executor: 60000
        auto.step3.supervisor: 30000
        auto.step4.summary: 45000
        fixed.client-call: 30000
      # 重试：仅对幂等的传输层瞬时故障生效（最大重试次数，不含首次）
      max-retries: 2
      retry-backoff-base-ms: 500
      # SSE 心跳间隔：防止慢节点期间连接被网关按 idle 掐断；<=0 关闭
      heartbeat-interval-ms: 15000
      # Step4 逐步执行之间的节流；配 0 完全关闭
      step-interval-ms: 300
      model-http:
        # 底层 HTTP 超时 —— 真正断开 socket 的一刀，必须与上面的节点超时配套
        connect-timeout-ms: 10000
        # 需 >= 最长的那个节点超时，否则正常长调用会被底层先掐断
        read-timeout-ms: 120000

# 小傅哥扳手通用组件配置
xfg:
  wrench:
    # 任务调度配置
    task:
      job:
        enabled: true
        pool-size: 5
        thread-name-prefix: "test-task-scheduler-"
        wait-for-tasks-to-complete-on-shutdown: true
        await-termination-seconds: 30
        refresh-interval: 30000
        clean-invalid-tasks-cron: "0 0/5 * * * ?"

# 日志
logging:
  level:
    root: info
  config: classpath:logback-spring.xml