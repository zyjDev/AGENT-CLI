server:
  port: 8091

# 管理端 JWT 签名密钥：test profile 虽然禁用了数据源，但 AdminJwtTokenService 仍会被创建，
# 因此这里**必须**给出一个 ≥32 字符的值（留空同样会启动失败）。
# 本地验证用值即可，切勿用于任何对外环境。
admin:
  jwt:
    secret: local-test-only-jwt-secret-please-replace-in-real-env
    expire-minutes: 720

# 线程池配置
thread:
  pool:
    executor:
      config:
        core-pool-size: 20
        max-pool-size: 50
        keep-alive-time: 5000
        block-queue-size: 5000
        policy: CallerRunsPolicy

# 登录 / 注册限流（2026-09-30 加固）：计数在进程内，重启即清空、多实例各算一份
xfg:
  ai:
    auth:
      login:
        max-failures: 5
        lock-minutes: 15
        failure-window-minutes: 15
      register:
        max-per-window: 20
        window-minutes: 60

# 简化配置，禁用数据库自动配置
spring:
  autoconfigure:
    exclude:
      - org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration
      - org.springframework.boot.autoconfigure.orm.jpa.HibernateJpaAutoConfiguration
      - org.mybatis.spring.boot.autoconfigure.MybatisAutoConfiguration
  ai:
    openai:
      base-url: https://apis.itedus.cn
      api-key: your_api_key_here
    agent:
      auto-config:
        enabled: false

# 日志
logging:
  level:
    root: info
    cn.bugstack.ai: debug
  config: classpath:logback-spring.xml