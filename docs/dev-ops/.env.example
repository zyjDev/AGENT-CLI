# 部署环境变量模板（2026-09-28 修复 P0-3）
#
# 用法：复制本文件为同目录下的 .env（已被 .gitignore 忽略，不会入库），填入真实值。
# 说明：docs/dev-ops 下的 docker-compose-*.yml 统一通过 ${VAR} 插值读取该文件，
#       凭据只保留一份，避免此前「同一批微信凭据复制到 4 个 compose、轮换漏改」的漂移问题。
#
# 安全提醒：
#   1. 本模板入库，禁止写入真实凭据；
#   2. .env 不入库，但仍建议随环境 isolate，不要跨机器拷贝；
#   3. 已泄漏过的凭据（微信 AppSecret / CSDN Cookie）必须先轮换再填这里。

# ---- MySQL（docker-compose-environment*.yml）----
MYSQL_ROOT_PASSWORD=change-me

# ---- Redis Admin（docker-compose-environment*.yml，默认 admin/admin 弱口令）----
REDIS_ADMIN_USER=admin
REDIS_ADMIN_PASSWORD=change-me

# ---- PostgreSQL / pgvector（docker-compose-environment*.yml）----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ---- pgAdmin（docker-compose-environment*.yml）----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ---- Grafana（docker-compose-grafana*.yml）----
GF_DATABASE_PASSWORD=change-me
GRAFANA_API_KEY=change-me

# ---- MCP：CSDN 发帖（docker-compose-mcp*.yml / docker-compose-app.yml）----
CSDN_API_COOKIE=change-me

# ---- MCP：微信公众号（docker-compose-mcp*.yml / docker-compose-app.yml）----
WEIXIN_API_ORIGINAL_ID=change-me
WEIXIN_API_APP_ID=change-me
WEIXIN_API_APP_SECRET=change-me
WEIXIN_API_TEMPLATE_ID=change-me
WEIXIN_API_TOUSER=change-me
