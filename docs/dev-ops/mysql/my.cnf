# =============================================================================
# MySQL 配置（挂载到容器内 /etc/mysql/conf.d/mysql.cnf）
#
# ⚠️ 本文件每次容器启动都会读取（不同于 init.sql 只在首次初始化执行）。
# =============================================================================

[mysqld]

# 字符集：库表统一 utf8mb4，避免 emoji 与生僻字写入报错
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# 认证插件：保持 mysql_native_password，兼容老版本客户端驱动
default-authentication-plugin = mysql_native_password

# 时区：容器默认 UTC，与 application-dev.yml 的 serverTimezone=Asia/Shanghai 对齐
default-time-zone = '+08:00'

# 单条 SQL 允许的最大包（RAG 文档内容入库时可能较大）
max_allowed_packet = 64M

[client]
default-character-set = utf8mb4
