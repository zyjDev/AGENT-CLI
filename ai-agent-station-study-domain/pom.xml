<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.bugstack.ai</groupId>
        <artifactId>ai-agent-station-study</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-agent-station-study-domain</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <!-- jjwt（io.jsonwebtoken）已移除：全项目 import 命中数为 0，
             实际使用的 JWT 库是 com.auth0:java-jwt -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>

        <!-- jtokkit：token 估算（上下文 token 预算管理） -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
        </dependency>

        <!-- jakarta.annotation-api：提供 @Resource 等注解。
             原先项目混用了两种注解来源：31 处 jakarta.annotation.Resource（正常传递获得）
             与 17 处 javax.annotation.Resource（Spring Boot 2 时代的旧包名），后者一直靠
             xfg-wrench-starter-design-framework 的 shaded fat jar 隐式提供（该 jar 内嵌
             javax/annotation/** 共 15 个 class）。移除该 starter 后这 17 处编译失败，
             故统一迁移到 jakarta.annotation.Resource（Spring Boot 3 规范）并显式声明本依赖。
             全项目共 48 处 @Resource（domain 32 / trigger 13 / infrastructure 2 / app 1）。
             版本由 spring-boot-starter-parent 统一管理，无需显式指定。 -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- spring ai 框架 begin -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pgvector-store</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client-webflux</artifactId>
        </dependency>

        <!-- spring-ai-rag：RAG 后置处理扩展点 DocumentPostProcessor 所在模块。
             1.1.8 里它不在任何 starter 的传递依赖里，必须显式引入（本地仓库原先没有这个 jar）。
             该 jar 只依赖 spring-ai-client-chat + spring-ai-vector-store，两者项目已有 →
             零新增传递依赖。附带还能拿到 QueryTransformer / MultiQueryExpander /
             RewriteQueryTransformer / ContextualQueryAugmenter 等官方 RAG 构件。
             版本由根 pom 的 spring-ai BOM 统一管理，无需写 version。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-rag</artifactId>
        </dependency>
        <!-- spring ai 框架 end -->

        <!-- 系统模块 -->
        <dependency>
            <groupId>cn.bugstack.ai</groupId>
            <artifactId>ai-agent-station-study-types</artifactId>
        </dependency>
        
        <!-- API 模块 -->
        <dependency>
            <groupId>cn.bugstack.ai</groupId>
            <artifactId>ai-agent-station-study-api</artifactId>
        </dependency>
        
        <!-- MyBatis-Plus 依赖已移除（2026-09-19）：
             全模块 grep `import com.baomidou` 命中数为 0 —— 领域层从未直接使用 ORM。
             PO / DAO / Mapper 全部在 infrastructure 模块，那里自己声明了本依赖。
             移除后领域层不再直接依赖持久化实现，符合「领域层与技术无关」的 DDD 约束。
             注：@Transactional 需要的 spring-tx 由 spring-ai-* / api 模块传递提供。 -->
    </dependencies>

    <build>
        <finalName>ai-agent-station-study-domain</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <compilerVersion>${java.version}</compilerVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
